@model int

@{
    var accessibleLabel = Model > 0
        ? $"Bildirimler, {Model} okunmamış bildirim"
        : "Bildirimler";
}

<a class="nav-link"
   asp-area=""
   asp-controller="Notifications"
   asp-action="Index"
   aria-label="@accessibleLabel">
    Bildirimler
    @if (Model > 0)
    {
        <span class="badge rounded-pill text-bg-light text-primary ms-1">
            @Model
            <span class="visually-hidden">okunmamış bildirim</span>
        </span>
    }
</a>
