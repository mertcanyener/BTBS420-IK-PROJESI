@model BTBS420.RecruitmentSystem.Web.ViewModels.PublicJobPostings.PublicJobPostingIndexViewModel

@{
    ViewData["Title"] = "Açık Pozisyonlar";
}

<h1 class="h2 mb-4">Açık Pozisyonlar</h1>

<form asp-controller="PublicJobPostings" asp-action="Index" method="get" class="row g-2 mb-4">
    <div class="col-12 col-md-4">
        <label class="form-label" for="positionId">Pozisyon</label>
        <select class="form-select" id="positionId" name="positionId">
            <option value="">Tümü</option>
            @foreach (var option in Model.PositionOptions)
            {
                <option value="@option.Id" selected="@(Model.PositionId == option.Id)">@option.Name</option>
            }
        </select>
    </div>
    <div class="col-12 col-md-3 d-flex align-items-end">
        <button type="submit" class="btn btn-primary w-100">Filtrele</button>
    </div>
</form>

@if (Model.JobPostings.Count == 0)
{
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4 text-center">
            <p class="text-body-secondary mb-0">Filtreye uyan açık pozisyon bulunamadı.</p>
        </div>
    </div>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th scope="col">Başlık</th>
                <th scope="col">Pozisyon</th>
                <th scope="col">Departman</th>
                <th scope="col">Son Başvuru Tarihi</th>
                <th scope="col" class="text-end">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var jobPosting in Model.JobPostings)
            {
                <tr>
                    <td>@jobPosting.Title</td>
                    <td>@jobPosting.PositionName</td>
                    <td>@jobPosting.DepartmentName</td>
                    <td>@jobPosting.ApplicationDeadline.ToString("dd.MM.yyyy")</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-controller="PublicJobPostings" asp-action="Details" asp-route-id="@jobPosting.Id">Detay</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Sayfalama">
            <ul class="pagination">
                @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                {
                    <li class="page-item @(pageNumber == Model.Page ? "active" : "")">
                        <a class="page-link" asp-controller="PublicJobPostings" asp-action="Index" asp-route-page="@pageNumber" asp-route-positionId="@Model.PositionId">@pageNumber</a>
                    </li>
                }
            </ul>
        </nav>
    }
}
