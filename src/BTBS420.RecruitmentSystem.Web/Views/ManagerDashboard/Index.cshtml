@model BTBS420.RecruitmentSystem.Web.ViewModels.Dashboard.ManagerDashboardViewModel

@{
    ViewData["Title"] = "Yönetici Dashboard";
}

<h1 class="h2 mb-4">Yönetici Dashboard</h1>

<form asp-controller="ManagerDashboard" asp-action="Index" method="get" class="row g-2 mb-4">
    <div class="col-12 col-md-3">
        <label class="form-label" for="positionId">Pozisyon</label>
        <select class="form-select" id="positionId" name="positionId">
            <option value="">Tümü</option>
            @foreach (var option in Model.FilterOptions.PositionOptions)
            {
                <option value="@option.Id" selected="@(Model.Filter.PositionId == option.Id)">@option.Name</option>
            }
        </select>
    </div>
    <div class="col-12 col-md-3">
        <label class="form-label" for="jobPostingId">İlan</label>
        <select class="form-select" id="jobPostingId" name="jobPostingId">
            <option value="">Tümü</option>
            @foreach (var option in Model.FilterOptions.JobPostingOptions)
            {
                <option value="@option.Id" selected="@(Model.Filter.JobPostingId == option.Id)">@option.Name</option>
            }
        </select>
    </div>
    <div class="col-6 col-md-2">
        <label class="form-label" for="dateFrom">Başlangıç</label>
        <input type="date" class="form-control" id="dateFrom" name="dateFrom" value="@Model.Filter.DateFrom?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-6 col-md-2">
        <label class="form-label" for="dateTo">Bitiş</label>
        <input type="date" class="form-control" id="dateTo" name="dateTo" value="@Model.Filter.DateTo?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-12 col-md-2 d-flex align-items-end">
        <button type="submit" class="btn btn-primary w-100">Filtrele</button>
    </div>
</form>

<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-lg-4 col-xl">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <p class="text-body-secondary mb-1">Açık Ekip Pozisyonu</p>
                <p class="h3 mb-0">@Model.Metrics.OpenPositions</p>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-4 col-xl">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <p class="text-body-secondary mb-1">Yeni</p>
                <p class="h3 mb-0">@Model.Metrics.NewCount</p>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-4 col-xl">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <p class="text-body-secondary mb-1">Ön Eleme</p>
                <p class="h3 mb-0">@Model.Metrics.ScreeningCount</p>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-4 col-xl">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <p class="text-body-secondary mb-1">Mülakat</p>
                <p class="h3 mb-0">@Model.Metrics.InterviewCount</p>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-4 col-xl">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <p class="text-body-secondary mb-1">İşe Alım</p>
                <p class="h3 mb-0">@Model.Metrics.HiredCount</p>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-4 col-xl">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <p class="text-body-secondary mb-1">Reddedildi</p>
                <p class="h3 mb-0">@Model.Metrics.RejectedCount</p>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-4 col-xl">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <p class="text-body-secondary mb-1">Geri Çekildi</p>
                <p class="h3 mb-0">@Model.Metrics.WithdrawnCount</p>
            </div>
        </div>
    </div>
</div>

<h2 class="h4 mb-3">Kısa Liste</h2>
@if (Model.Shortlist.Count == 0)
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4 text-center">
            <p class="text-body-secondary mb-0">Seçtiğiniz filtrelerde kısa listede aday bulunamadı.</p>
        </div>
    </div>
}
else
{
    <table class="table align-middle mb-4">
        <thead>
            <tr>
                <th scope="col">Aday</th>
                <th scope="col">İlan</th>
                <th scope="col">Durum</th>
                <th scope="col">Başvuru Tarihi</th>
                <th scope="col" class="text-end">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var application in Model.Shortlist)
            {
                <tr>
                    <td>@application.CandidateFullName</td>
                    <td>@application.JobPostingTitle</td>
                    <td><span class="badge text-bg-secondary">@application.ApplicationStatusLabel</span></td>
                    <td>@application.AppliedAtUtc.ToString("dd.MM.yyyy HH:mm")</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-controller="ApplicationsPool" asp-action="Details" asp-route-id="@application.Id">Detay</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <p class="text-end"><a asp-controller="ApplicationsPool" asp-action="Index">Tümünü Gör</a></p>
}

<h2 class="h4 mb-3">Bekleyen Değerlendirmeler</h2>
@if (Model.PendingEvaluations.Count == 0)
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4 text-center">
            <p class="text-body-secondary mb-0">Seçtiğiniz filtrelerde bekleyen değerlendirme bulunamadı.</p>
        </div>
    </div>
}
else
{
    <table class="table align-middle mb-4">
        <thead>
            <tr>
                <th scope="col">Aday</th>
                <th scope="col">İlan</th>
                <th scope="col">Mülakat Tarihi</th>
                <th scope="col">Eksik Değerlendiriciler</th>
                <th scope="col" class="text-end">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var evaluation in Model.PendingEvaluations)
            {
                <tr>
                    <td>@evaluation.CandidateFullName</td>
                    <td>@evaluation.JobPostingTitle</td>
                    <td>@evaluation.StartAtUtc.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@string.Join(", ", evaluation.MissingEvaluatorNames)</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-controller="Interviews" asp-action="Details" asp-route-id="@evaluation.InterviewId">Detay</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <p class="text-end"><a asp-controller="Interviews" asp-action="Index">Tümünü Gör</a></p>
}
