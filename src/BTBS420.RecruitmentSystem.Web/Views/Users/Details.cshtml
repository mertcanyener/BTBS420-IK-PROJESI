@model BTBS420.RecruitmentSystem.Web.ViewModels.Users.UserDetailsViewModel
@using BTBS420.RecruitmentSystem.Web.Authorization

@{
    ViewData["Title"] = "Kullanıcı Detayı";
    var isInternalUser =
        Model.Roles.Contains(SystemRoles.Admin) ||
        Model.Roles.Contains(SystemRoles.RecruitmentSpecialist) ||
        Model.Roles.Contains(SystemRoles.HiringManager);
}

<h1 class="h2 mb-4">Kullanıcı Detayı</h1>

@if (TempData[BTBS420.RecruitmentSystem.Web.Controllers.UsersController.GeneratedTemporaryPasswordTempDataKey] is string temporaryPassword)
{
    <div class="alert alert-warning">
        <strong>Geçici şifre:</strong> <code>@temporaryPassword</code>
        <div class="small mt-1">Bu şifre yalnızca bir kez gösterilir, kullanıcıya güvenli bir şekilde iletin.</div>
    </div>
}

@if (TempData[BTBS420.RecruitmentSystem.Web.Controllers.UsersController.UserActionErrorTempDataKey] is string userActionError)
{
    <div class="alert alert-danger">@userActionError</div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <dl class="row mb-0">
            <dt class="col-sm-3">Kullanıcı Adı</dt>
            <dd class="col-sm-9">@Model.UserName</dd>

            <dt class="col-sm-3">E-posta</dt>
            <dd class="col-sm-9">@Model.Email</dd>

            <dt class="col-sm-3">Roller</dt>
            <dd class="col-sm-9">
                @if (Model.Roles.Count == 0)
                {
                    <span>-</span>
                }
                else
                {
                    @string.Join(", ", Model.Roles)
                }
            </dd>

            <dt class="col-sm-3">Departman</dt>
            <dd class="col-sm-9">@(Model.DepartmentName ?? "-")</dd>

            <dt class="col-sm-3">Durum</dt>
            <dd class="col-sm-9">
                @if (Model.IsActive)
                {
                    <span class="badge text-bg-success">Aktif</span>
                }
                else
                {
                    <span class="badge text-bg-secondary">Pasif</span>
                }
            </dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <a class="btn btn-outline-secondary" asp-controller="Users" asp-action="Index">Listeye Dön</a>
    <a class="btn btn-primary" asp-controller="Users" asp-action="Edit" asp-route-id="@Model.Id">Düzenle</a>

    @if (isInternalUser)
    {
        if (Model.IsActive)
        {
            <form asp-controller="Users" asp-action="Deactivate" asp-route-id="@Model.Id" method="post" class="d-inline">
                <button type="submit" class="btn btn-outline-danger">Pasifleştir</button>
            </form>
        }
        else
        {
            <form asp-controller="Users" asp-action="Activate" asp-route-id="@Model.Id" method="post" class="d-inline">
                <button type="submit" class="btn btn-outline-success">Aktifleştir</button>
            </form>
        }

        <form asp-controller="Users" asp-action="ResetPassword" asp-route-id="@Model.Id" method="post" class="d-inline">
            <button type="submit" class="btn btn-outline-warning">Şifreyi Sıfırla</button>
        </form>
    }
</div>

<h2 class="h4 mt-4 mb-3">İşlem Geçmişi</h2>
<p>
    <a asp-controller="ActivityLogs" asp-action="Index" asp-route-userId="@Model.Id">Tüm Aktivite Kayıtlarında Gör</a>
</p>

@if (Model.ActivityLog.Count == 0)
{
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4 text-center">
            <p class="text-body-secondary mb-0">Bu kullanıcıya ait işlem kaydı bulunamadı.</p>
        </div>
    </div>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th scope="col">Tarih</th>
                <th scope="col">Yapan</th>
                <th scope="col">Olay</th>
                <th scope="col">Açıklama</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var entry in Model.ActivityLog)
            {
                <tr>
                    <td>@entry.OccurredAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@entry.ActorName</td>
                    <td>@entry.ActionLabel</td>
                    <td>@entry.Summary</td>
                </tr>
            }
        </tbody>
    </table>
}
