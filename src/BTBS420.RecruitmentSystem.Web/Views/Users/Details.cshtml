@model BTBS420.RecruitmentSystem.Web.ViewModels.Users.UserDetailsViewModel

@{
    ViewData["Title"] = "Kullanıcı Detayı";
}

<h1 class="h2 mb-4">Kullanıcı Detayı</h1>

@if (TempData[BTBS420.RecruitmentSystem.Web.Controllers.UsersController.GeneratedTemporaryPasswordTempDataKey] is string temporaryPassword)
{
    <div class="alert alert-warning">
        <strong>Geçici şifre:</strong> <code>@temporaryPassword</code>
        <div class="small mt-1">Bu şifre yalnızca bir kez gösterilir, kullanıcıya güvenli bir şekilde iletin.</div>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <dl class="row mb-0">
            <dt class="col-sm-3">Kullanıcı Adı</dt>
            <dd class="col-sm-9">@Model.UserName</dd>

            <dt class="col-sm-3">E-posta</dt>
            <dd class="col-sm-9">@Model.Email</dd>

            <dt class="col-sm-3">Roller</dt>
            <dd class="col-sm-9">
                @if (Model.Roles.Count == 0)
                {
                    <span>-</span>
                }
                else
                {
                    @string.Join(", ", Model.Roles)
                }
            </dd>

            <dt class="col-sm-3">Departman</dt>
            <dd class="col-sm-9">@(Model.DepartmentName ?? "-")</dd>

            <dt class="col-sm-3">Durum</dt>
            <dd class="col-sm-9">
                @if (Model.IsActive)
                {
                    <span class="badge text-bg-success">Aktif</span>
                }
                else
                {
                    <span class="badge text-bg-secondary">Pasif</span>
                }
            </dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <a class="btn btn-outline-secondary" asp-controller="Users" asp-action="Index">Listeye Dön</a>
    <a class="btn btn-primary" asp-controller="Users" asp-action="Edit" asp-route-id="@Model.Id">Düzenle</a>
</div>
