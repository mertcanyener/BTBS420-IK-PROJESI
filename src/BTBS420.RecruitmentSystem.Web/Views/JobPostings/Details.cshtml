@model BTBS420.RecruitmentSystem.Web.ViewModels.JobPostings.JobPostingDetailViewModel
@using BTBS420.RecruitmentSystem.Web.Authorization
@using BTBS420.RecruitmentSystem.Web.Models

@{
    ViewData["Title"] = "İlan Detayı";
    var canManage = User.IsInRole(SystemRoles.Admin) || User.IsInRole(SystemRoles.RecruitmentSpecialist);
    var allowedNextStatuses = JobPostingStatuses.GetAllowedNextStatuses(Model.Status);
}

<h1 class="h2 mb-4">İlan Detayı</h1>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <dl class="row mb-0">
            <dt class="col-sm-3">Başlık</dt>
            <dd class="col-sm-9">@Model.Title</dd>

            <dt class="col-sm-3">Açıklama</dt>
            <dd class="col-sm-9">@Model.Description</dd>

            <dt class="col-sm-3">Pozisyon</dt>
            <dd class="col-sm-9">@Model.PositionName</dd>

            <dt class="col-sm-3">Departman</dt>
            <dd class="col-sm-9">@Model.DepartmentName</dd>

            <dt class="col-sm-3">Sorumlu Uzman</dt>
            <dd class="col-sm-9">@Model.ResponsibleUserName</dd>

            <dt class="col-sm-3">Son Başvuru Tarihi</dt>
            <dd class="col-sm-9">@Model.ApplicationDeadline.ToString("dd.MM.yyyy")</dd>

            <dt class="col-sm-3">Durum</dt>
            <dd class="col-sm-9"><span class="badge text-bg-secondary">@Model.Status</span></dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <a class="btn btn-outline-secondary" asp-controller="JobPostings" asp-action="Index">Listeye Dön</a>
    @if (canManage)
    {
        <a class="btn btn-primary" asp-controller="JobPostings" asp-action="Edit" asp-route-id="@Model.Id">Düzenle</a>
        @foreach (var nextStatus in allowedNextStatuses)
        {
            <form asp-controller="JobPostings" asp-action="ChangeStatus" method="post" class="d-inline">
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="newStatus" value="@nextStatus" />
                <button type="submit" class="btn btn-outline-primary">Durumu değiştir: @nextStatus</button>
            </form>
        }
        @if (Model.Status == JobPostingStatuses.Draft)
        {
            <form asp-controller="JobPostings" asp-action="Delete" method="post" class="d-inline">
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-outline-danger">Sil</button>
            </form>
        }
    }
</div>
