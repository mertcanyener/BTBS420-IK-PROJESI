@model BTBS420.RecruitmentSystem.Web.ViewModels.JobPostings.JobPostingFormViewModel

@{
    ViewData["Title"] = "Yeni İlan";
}

<h1 class="h3 mb-4">Yeni İlan</h1>

<div class="row">
    <div class="col-12 col-md-6">
        <form asp-controller="JobPostings" asp-action="Create" method="post" asp-antiforgery="true" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PositionId" class="form-label"></label>
                <select asp-for="PositionId" class="form-select">
                    <option value="">Seçiniz</option>
                    @foreach (var option in Model.PositionOptions)
                    {
                        <option value="@option.Id">@option.Name</option>
                    }
                </select>
                <span asp-validation-for="PositionId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ResponsibleUserId" class="form-label"></label>
                <select asp-for="ResponsibleUserId" class="form-select">
                    <option value="">Seçiniz</option>
                    @foreach (var option in Model.ResponsibleUserOptions)
                    {
                        <option value="@option.Id">@option.Name</option>
                    }
                </select>
                <span asp-validation-for="ResponsibleUserId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ApplicationDeadline" class="form-label"></label>
                <input asp-for="ApplicationDeadline" class="form-control" />
                <span asp-validation-for="ApplicationDeadline" class="text-danger"></span>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="IsInternal" class="form-check-input" />
                <label asp-for="IsInternal" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn btn-primary">Oluştur</button>
            <a class="btn btn-outline-secondary" asp-controller="JobPostings" asp-action="Index">Vazgeç</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
