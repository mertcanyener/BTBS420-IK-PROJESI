@model BTBS420.RecruitmentSystem.Web.ViewModels.Languages.LanguageIndexViewModel

@{
    ViewData["Title"] = "Diller";
}

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
    <h1 class="h2 mb-0">Diller</h1>
    <a class="btn btn-primary" asp-controller="Languages" asp-action="Create">Yeni Dil</a>
</div>

@if (Model.Languages.Count == 0)
{
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4 text-center">
            <p class="text-body-secondary mb-0">Henüz dil eklenmedi.</p>
        </div>
    </div>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th scope="col">Ad</th>
                <th scope="col">Durum</th>
                <th scope="col" class="text-end">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var language in Model.Languages)
            {
                <tr>
                    <td>@language.Name</td>
                    <td>
                        @if (language.IsActive)
                        {
                            <span class="badge text-bg-success">Aktif</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Pasif</span>
                        }
                    </td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-controller="Languages" asp-action="Edit" asp-route-id="@language.Id">Düzenle</a>
                        @if (language.IsActive)
                        {
                            <form asp-controller="Languages" asp-action="Deactivate" asp-route-id="@language.Id" method="post" asp-antiforgery="true" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Pasife Al</button>
                            </form>
                        }
                        else
                        {
                            <form asp-controller="Languages" asp-action="Activate" asp-route-id="@language.Id" method="post" asp-antiforgery="true" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-success">Aktifleştir</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
