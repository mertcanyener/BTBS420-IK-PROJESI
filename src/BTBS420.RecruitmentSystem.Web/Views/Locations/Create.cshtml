@model BTBS420.RecruitmentSystem.Web.ViewModels.Locations.LocationFormViewModel

@{
    ViewData["Title"] = "Yeni Konum";
}

<h1 class="h3 mb-4">Yeni Konum</h1>

<div class="row">
    <div class="col-12 col-md-6">
        <form asp-controller="Locations" asp-action="Create" method="post" asp-antiforgery="true" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Oluştur</button>
            <a class="btn btn-outline-secondary" asp-controller="Locations" asp-action="Index">Vazgeç</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
