@model BTBS420.RecruitmentSystem.Web.ViewModels.Dashboard.SpecialistDashboardViewModel
@using BTBS420.RecruitmentSystem.Web.Models

@{
    ViewData["Title"] = "Uzman Dashboard";
}

<h1 class="h2 mb-4">Uzman Dashboard</h1>

<form asp-controller="SpecialistDashboard" asp-action="Index" method="get" class="row g-2 mb-4">
    <div class="col-12 col-md-2">
        <label class="form-label" for="status">Durum</label>
        <select class="form-select" id="status" name="status">
            <option value="">Tümü</option>
            @foreach (var statusOption in Model.FilterOptions.StatusOptions)
            {
                <option value="@statusOption" selected="@(Model.Filter.Status == statusOption)">@ApplicationStatuses.GetDisplayLabel(statusOption)</option>
            }
        </select>
    </div>
    <div class="col-12 col-md-2">
        <label class="form-label" for="departmentId">Departman</label>
        <select class="form-select" id="departmentId" name="departmentId">
            <option value="">Tümü</option>
            @foreach (var option in Model.FilterOptions.DepartmentOptions)
            {
                <option value="@option.Id" selected="@(Model.Filter.DepartmentId == option.Id)">@option.Name</option>
            }
        </select>
    </div>
    <div class="col-12 col-md-2">
        <label class="form-label" for="positionId">Pozisyon</label>
        <select class="form-select" id="positionId" name="positionId">
            <option value="">Tümü</option>
            @foreach (var option in Model.FilterOptions.PositionOptions)
            {
                <option value="@option.Id" selected="@(Model.Filter.PositionId == option.Id)">@option.Name</option>
            }
        </select>
    </div>
    <div class="col-12 col-md-2">
        <label class="form-label" for="jobPostingId">İlan</label>
        <select class="form-select" id="jobPostingId" name="jobPostingId">
            <option value="">Tümü</option>
            @foreach (var option in Model.FilterOptions.JobPostingOptions)
            {
                <option value="@option.Id" selected="@(Model.Filter.JobPostingId == option.Id)">@option.Name</option>
            }
        </select>
    </div>
    <div class="col-6 col-md-1">
        <label class="form-label" for="dateFrom">Başlangıç</label>
        <input type="date" class="form-control" id="dateFrom" name="dateFrom" value="@Model.Filter.DateFrom?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-6 col-md-1">
        <label class="form-label" for="dateTo">Bitiş</label>
        <input type="date" class="form-control" id="dateTo" name="dateTo" value="@Model.Filter.DateTo?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-12 col-md-2 d-flex align-items-end">
        <button type="submit" class="btn btn-primary w-100">Filtrele</button>
    </div>
</form>

<h2 class="h4 mb-3">Sorumlu İlanlar</h2>
@if (Model.JobPostings.Count == 0)
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4 text-center">
            <p class="text-body-secondary mb-0">Seçtiğiniz filtrelerde sorumlu ilan bulunamadı.</p>
        </div>
    </div>
}
else
{
    <table class="table align-middle mb-4">
        <thead>
            <tr>
                <th scope="col">Başlık</th>
                <th scope="col">Pozisyon</th>
                <th scope="col">Departman</th>
                <th scope="col">Durum</th>
                <th scope="col">Son Başvuru Tarihi</th>
                <th scope="col" class="text-end">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var jobPosting in Model.JobPostings)
            {
                <tr>
                    <td>@jobPosting.Title</td>
                    <td>@jobPosting.PositionName</td>
                    <td>@jobPosting.DepartmentName</td>
                    <td>@jobPosting.Status</td>
                    <td>@jobPosting.ApplicationDeadline.ToString("dd.MM.yyyy")</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-controller="JobPostings" asp-action="Details" asp-route-id="@jobPosting.Id">Detay</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <p class="text-end"><a asp-controller="JobPostings" asp-action="Index">Tümünü Gör</a></p>
}

<h2 class="h4 mb-3">Aday Havuzu</h2>
@if (Model.CandidatePool.Count == 0)
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4 text-center">
            <p class="text-body-secondary mb-0">Seçtiğiniz filtrelerde aday başvurusu bulunamadı.</p>
        </div>
    </div>
}
else
{
    <table class="table align-middle mb-4">
        <thead>
            <tr>
                <th scope="col">Aday</th>
                <th scope="col">İlan</th>
                <th scope="col">Durum</th>
                <th scope="col">Başvuru Tarihi</th>
                <th scope="col" class="text-end">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var application in Model.CandidatePool)
            {
                <tr>
                    <td>@application.CandidateFullName</td>
                    <td>@application.JobPostingTitle</td>
                    <td><span class="badge text-bg-secondary">@application.ApplicationStatusLabel</span></td>
                    <td>@application.AppliedAtUtc.ToString("dd.MM.yyyy HH:mm")</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-controller="ApplicationsPool" asp-action="Details" asp-route-id="@application.Id">Detay</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <p class="text-end"><a asp-controller="ApplicationsPool" asp-action="Index">Tümünü Gör</a></p>
}

<h2 class="h4 mb-3">Yaklaşan Mülakatlar</h2>
@if (Model.UpcomingInterviews.Count == 0)
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4 text-center">
            <p class="text-body-secondary mb-0">Seçtiğiniz filtrelerde yaklaşan mülakat bulunamadı.</p>
        </div>
    </div>
}
else
{
    <table class="table align-middle mb-4">
        <thead>
            <tr>
                <th scope="col">Aday</th>
                <th scope="col">İlan</th>
                <th scope="col">Tür</th>
                <th scope="col">Başlangıç</th>
                <th scope="col" class="text-end">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var interview in Model.UpcomingInterviews)
            {
                <tr>
                    <td>@interview.CandidateFullName</td>
                    <td>@interview.JobPostingTitle</td>
                    <td>@interview.InterviewTypeLabel</td>
                    <td>@interview.StartAtUtc.ToString("dd.MM.yyyy HH:mm")</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-controller="Interviews" asp-action="Details" asp-route-id="@interview.Id">Detay</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <p class="text-end"><a asp-controller="Interviews" asp-action="Index">Tümünü Gör</a></p>
}

<h2 class="h4 mb-3">Bekleyen Teklifler</h2>
@if (Model.PendingOffers.Count == 0)
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4 text-center">
            <p class="text-body-secondary mb-0">Seçtiğiniz filtrelerde bekleyen teklif bulunamadı.</p>
        </div>
    </div>
}
else
{
    <table class="table align-middle mb-4">
        <thead>
            <tr>
                <th scope="col">Aday</th>
                <th scope="col">İlan</th>
                <th scope="col">Maaş</th>
                <th scope="col">Başlangıç Tarihi</th>
                <th scope="col" class="text-end">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var offer in Model.PendingOffers)
            {
                <tr>
                    <td>@offer.CandidateFullName</td>
                    <td>@offer.JobPostingTitle</td>
                    <td>@offer.Salary.ToString("N2")</td>
                    <td>@offer.StartDate.ToString("dd.MM.yyyy")</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-controller="Offers" asp-action="Edit" asp-route-id="@offer.Id">Detay</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
