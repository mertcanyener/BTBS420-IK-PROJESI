@model BTBS420.RecruitmentSystem.Web.ViewModels.Account.LoginViewModel

@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-6 col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 mb-4">Giriş Yap</h1>

                @if (TempData["RegistrationSuccessMessage"] is string registrationSuccessMessage)
                {
                    <div class="alert alert-success" role="alert">@registrationSuccessMessage</div>
                }

                <form asp-controller="Account" asp-action="Login" method="post" asp-antiforgery="true" novalidate>
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="UsernameOrEmail" class="form-label"></label>
                        <input asp-for="UsernameOrEmail" class="form-control" autocomplete="username" />
                        <span asp-validation-for="UsernameOrEmail" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Giriş Yap</button>
                </form>

                <p class="mt-3 mb-0 text-center">
                    <a asp-controller="Account" asp-action="Register">Hesabınız yok mu? Kayıt Ol</a>
                </p>
                <p class="mt-2 mb-0 text-center">
                    <a asp-controller="Account" asp-action="ForgotPassword">Parolanızı mı unuttunuz?</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
