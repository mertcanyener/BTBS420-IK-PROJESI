@model BTBS420.RecruitmentSystem.Web.ViewModels.Account.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Parolamı Unuttum";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-6 col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 mb-4">Parolamı Unuttum</h1>

                @if (TempData["ForgotPasswordMessage"] is string forgotPasswordMessage)
                {
                    <div class="alert alert-success" role="alert">@forgotPasswordMessage</div>
                }

                <form asp-controller="Account" asp-action="ForgotPassword" method="post" asp-antiforgery="true" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Sıfırlama Bağlantısı Gönder</button>
                </form>

                <p class="mt-3 mb-0 text-center">
                    <a asp-controller="Account" asp-action="Login">Giriş sayfasına dön</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
