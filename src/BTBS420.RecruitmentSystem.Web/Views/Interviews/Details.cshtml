@model BTBS420.RecruitmentSystem.Web.ViewModels.Interviews.InterviewDetailViewModel

@{
    ViewData["Title"] = "Mülakat Detayı";
}

<h1 class="h2 mb-4">Mülakat Detayı</h1>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <dl class="row mb-0">
            <dt class="col-sm-3">Aday</dt>
            <dd class="col-sm-9">@Model.CandidateFullName</dd>

            <dt class="col-sm-3">İlan</dt>
            <dd class="col-sm-9">@Model.JobPostingTitle</dd>

            <dt class="col-sm-3">Pozisyon</dt>
            <dd class="col-sm-9">@Model.PositionName</dd>

            <dt class="col-sm-3">Departman</dt>
            <dd class="col-sm-9">@Model.DepartmentName</dd>

            <dt class="col-sm-3">Tür</dt>
            <dd class="col-sm-9">@Model.InterviewTypeLabel</dd>

            <dt class="col-sm-3">Başlangıç</dt>
            <dd class="col-sm-9">@Model.StartAtUtc.ToString("dd.MM.yyyy HH:mm")</dd>

            <dt class="col-sm-3">Bitiş</dt>
            <dd class="col-sm-9">@Model.EndAtUtc.ToString("dd.MM.yyyy HH:mm")</dd>

            @if (!string.IsNullOrWhiteSpace(Model.OnlineMeetingLink))
            {
                <dt class="col-sm-3">Toplantı Linki</dt>
                <dd class="col-sm-9"><a href="@Model.OnlineMeetingLink" target="_blank" rel="noopener">@Model.OnlineMeetingLink</a></dd>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Location))
            {
                <dt class="col-sm-3">Konum</dt>
                <dd class="col-sm-9">@Model.Location</dd>
            }

            <dt class="col-sm-3">Durum</dt>
            <dd class="col-sm-9">
                <span class="status-pill @(Model.StatusLabel switch
                {
                    "Planlandı" => "status-interview",
                    "Tamamlandı" => "status-hired",
                    "İptal Edildi" => "status-neutral",
                    _ => "status-neutral"
                })">@Model.StatusLabel</span>
            </dd>

            <dt class="col-sm-3">Katılımcılar</dt>
            <dd class="col-sm-9">@(Model.ParticipantNames.Count == 0 ? "-" : string.Join(", ", Model.ParticipantNames))</dd>
        </dl>
    </div>
</div>

@if (Model.CanViewEvaluationSummary)
{
    <div class="card border-0 shadow-sm mt-3">
        <div class="card-body p-4">
            <h2 class="h5 mb-3">Değerlendirme Özeti</h2>
            @if (Model.EvaluationSummary.Count == 0)
            {
                <p class="text-muted mb-0">Henüz değerlendirme yapılmadı.</p>
            }
            else
            {
                <p class="mb-3">
                    Ortalama Yetkinlik Puanı: <strong>@Model.AverageCompetencyScore?.ToString("0.0")</strong>
                    ·
                    Ortalama Genel Puan: <strong>@Model.AverageOverallScore?.ToString("0.0")</strong>
                </p>
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th>Panelist</th>
                                <th>Yetkinlik Puanı</th>
                                <th>Genel Puan</th>
                                <th>Öneri</th>
                                <th>Not</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var evaluation in Model.EvaluationSummary)
                            {
                                <tr>
                                    <td>@evaluation.EvaluatorName</td>
                                    <td>@evaluation.CompetencyScore</td>
                                    <td>@evaluation.OverallScore</td>
                                    <td>@evaluation.RecommendationLabel</td>
                                    <td>@evaluation.Note</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@if (Model.CanAddEvaluation)
{
    <div class="card border-0 shadow-sm mt-3">
        <div class="card-body p-4">
            <h2 class="h5 mb-3">Değerlendirme Ekle</h2>
            <form asp-controller="InterviewEvaluations" asp-action="Create" method="post" asp-antiforgery="true">
                <input type="hidden" name="interviewId" value="@Model.Id" />
                <div class="mb-2">
                    <label class="form-label">Not</label>
                    <textarea class="form-control" name="note" rows="3"></textarea>
                </div>
                <div class="row">
                    <div class="col-sm-4 mb-2">
                        <label class="form-label">Yetkinlik Puanı</label>
                        <select class="form-select" name="competencyScore" required>
                            @for (var score = 1; score <= 5; score++)
                            {
                                <option value="@score">@score</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm-4 mb-2">
                        <label class="form-label">Genel Puan</label>
                        <select class="form-select" name="overallScore" required>
                            @for (var score = 1; score <= 5; score++)
                            {
                                <option value="@score">@score</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm-4 mb-2">
                        <label class="form-label">Öneri</label>
                        <select class="form-select" name="recommendation" required>
                            <option value="positive">Olumlu</option>
                            <option value="negative">Olumsuz</option>
                        </select>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary">Değerlendirmeyi Kaydet</button>
            </form>
        </div>
    </div>
}
else if (Model.HasEvaluated)
{
    <div class="alert alert-success mt-3" role="status">Değerlendirmeniz kaydedildi.</div>
}

<div class="mt-3 d-flex flex-wrap gap-2">
    <a class="btn btn-outline-secondary" asp-controller="Interviews" asp-action="Index">Listeye Dön</a>
    @if (Model.CanEdit)
    {
        <a class="btn btn-primary" asp-controller="Interviews" asp-action="Edit" asp-route-id="@Model.Id">Düzenle / Ertele</a>
    }
    @if (Model.CanComplete)
    {
        <form asp-controller="Interviews" asp-action="Complete" asp-route-id="@Model.Id" method="post" asp-antiforgery="true">
            <button type="submit" class="btn btn-outline-success">Tamamlandı Olarak İşaretle</button>
        </form>
    }
    @if (Model.CanCancel)
    {
        <form asp-controller="Interviews" asp-action="Cancel" asp-route-id="@Model.Id" method="post" asp-antiforgery="true">
            <button type="submit" class="btn btn-outline-danger">İptal Et</button>
        </form>
    }
</div>
