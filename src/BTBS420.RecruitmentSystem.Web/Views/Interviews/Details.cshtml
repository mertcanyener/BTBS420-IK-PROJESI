@model BTBS420.RecruitmentSystem.Web.ViewModels.Interviews.InterviewDetailViewModel

@{
    ViewData["Title"] = "Mülakat Detayı";
}

<h1 class="h2 mb-4">Mülakat Detayı</h1>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <dl class="row mb-0">
            <dt class="col-sm-3">Aday</dt>
            <dd class="col-sm-9">@Model.CandidateFullName</dd>

            <dt class="col-sm-3">İlan</dt>
            <dd class="col-sm-9">@Model.JobPostingTitle</dd>

            <dt class="col-sm-3">Pozisyon</dt>
            <dd class="col-sm-9">@Model.PositionName</dd>

            <dt class="col-sm-3">Departman</dt>
            <dd class="col-sm-9">@Model.DepartmentName</dd>

            <dt class="col-sm-3">Tür</dt>
            <dd class="col-sm-9">@Model.InterviewTypeLabel</dd>

            <dt class="col-sm-3">Başlangıç</dt>
            <dd class="col-sm-9">@Model.StartAtUtc.ToString("dd.MM.yyyy HH:mm")</dd>

            <dt class="col-sm-3">Bitiş</dt>
            <dd class="col-sm-9">@Model.EndAtUtc.ToString("dd.MM.yyyy HH:mm")</dd>

            @if (!string.IsNullOrWhiteSpace(Model.OnlineMeetingLink))
            {
                <dt class="col-sm-3">Toplantı Linki</dt>
                <dd class="col-sm-9"><a href="@Model.OnlineMeetingLink" target="_blank" rel="noopener">@Model.OnlineMeetingLink</a></dd>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Location))
            {
                <dt class="col-sm-3">Konum</dt>
                <dd class="col-sm-9">@Model.Location</dd>
            }

            <dt class="col-sm-3">Durum</dt>
            <dd class="col-sm-9"><span class="badge text-bg-secondary">@Model.StatusLabel</span></dd>

            <dt class="col-sm-3">Katılımcılar</dt>
            <dd class="col-sm-9">@(Model.ParticipantNames.Count == 0 ? "-" : string.Join(", ", Model.ParticipantNames))</dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <a class="btn btn-outline-secondary" asp-controller="Interviews" asp-action="Index">Listeye Dön</a>
    @if (Model.CanEdit)
    {
        <a class="btn btn-primary" asp-controller="Interviews" asp-action="Edit" asp-route-id="@Model.Id">Düzenle</a>
    }
</div>
