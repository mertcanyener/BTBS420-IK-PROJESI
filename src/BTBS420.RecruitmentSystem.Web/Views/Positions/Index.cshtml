@model BTBS420.RecruitmentSystem.Web.ViewModels.Positions.PositionIndexViewModel

@{
    ViewData["Title"] = "Pozisyonlar";
}

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
    <h1 class="h2 mb-0">Pozisyonlar</h1>
    <a class="btn btn-primary" asp-controller="Positions" asp-action="Create">Yeni Pozisyon</a>
</div>

@if (Model.Positions.Count == 0)
{
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4 text-center">
            <p class="text-body-secondary mb-0">Henüz pozisyon eklenmedi.</p>
        </div>
    </div>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th scope="col">Ad</th>
                <th scope="col">Departman</th>
                <th scope="col">İş Ailesi</th>
                <th scope="col">Kıdem</th>
                <th scope="col">Durum</th>
                <th scope="col" class="text-end">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var position in Model.Positions)
            {
                <tr>
                    <td>@position.Name</td>
                    <td>@position.DepartmentName</td>
                    <td>@(position.JobFamilyName ?? "-")</td>
                    <td>@(position.SeniorityName ?? "-")</td>
                    <td>
                        @if (position.IsActive)
                        {
                            <span class="badge text-bg-success">Aktif</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Pasif</span>
                        }
                    </td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-controller="Positions" asp-action="Edit" asp-route-id="@position.Id">Düzenle</a>
                        @if (position.IsActive)
                        {
                            <form asp-controller="Positions" asp-action="Deactivate" asp-route-id="@position.Id" method="post" asp-antiforgery="true" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Pasife Al</button>
                            </form>
                        }
                        else
                        {
                            <form asp-controller="Positions" asp-action="Activate" asp-route-id="@position.Id" method="post" asp-antiforgery="true" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-success">Aktifleştir</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
