@model BTBS420.RecruitmentSystem.Web.ViewModels.CandidateExperiences.CandidateExperienceFormViewModel

@{
    ViewData["Title"] = "Deneyimi Düzenle";
}

<h1 class="h3 mb-4">Deneyimi Düzenle</h1>

<div class="row">
    <div class="col-12 col-md-8">
        <form asp-controller="CandidateExperiences" asp-action="Edit" asp-route-id="@Model.Id" method="post" asp-antiforgery="true" novalidate>
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="CompanyName" class="form-label"></label>
                <input asp-for="CompanyName" class="form-control" />
                <span asp-validation-for="CompanyName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="JobTitle" class="form-label"></label>
                <input asp-for="JobTitle" class="form-control" />
                <span asp-validation-for="JobTitle" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="StartDate" class="form-label"></label>
                <input asp-for="StartDate" class="form-control" />
                <span asp-validation-for="StartDate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="EndDate" class="form-label"></label>
                <input asp-for="EndDate" class="form-control" />
                <span asp-validation-for="EndDate" class="text-danger"></span>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="IsOngoing" class="form-check-input" />
                <label asp-for="IsOngoing" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn btn-primary">Kaydet</button>
            <a class="btn btn-outline-secondary" asp-controller="CandidateExperiences" asp-action="Index">Vazgeç</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
